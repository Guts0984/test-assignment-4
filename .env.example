# Copy this file to .env (cp .env.example .env). The values below are demo values for running on your own machine.
POSTGRES_USER=tickets
POSTGRES_PASSWORD=local-demo-postgres-password
POSTGRES_DB=tickets

REDIS_PASSWORD=local-demo-redis-password

# Passwords of the seeded users (logins are in the README). At least 8 characters.
# The database and Redis passwords are put into connection URLs, so use only letters, digits, - and _.
SEED_ADMIN_PASSWORD=local-demo-admin-password
SEED_USER_PASSWORD=local-demo-user-password

# Signs the calls between our own programs (the web server tells the api who the visitor is; the worker tells the web
# server to drop cached pages). At least 32 characters. Make your own for anything but a local try-out.
INTERNAL_SECRET=local-demo-internal-secret-0123456789abcdef

# Set to "true" when the site is served over https: the session cookie then gets the Secure flag.
COOKIE_SECURE=false

LOG_LEVEL=info

# The one port that is open to the outside (nginx).
WEB_HOST_PORT=8080
