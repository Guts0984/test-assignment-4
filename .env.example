# Copy this file to .env (cp .env.example .env). The values below are demo values for running on your own machine.
POSTGRES_USER=tickets
POSTGRES_PASSWORD=local-demo-postgres-password
POSTGRES_DB=tickets

REDIS_PASSWORD=local-demo-redis-password

LOG_LEVEL=info

# The one port that is open to the outside (nginx).
WEB_HOST_PORT=8080
