    "loadtest": "pnpm --filter @app/loadtest loadtest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-functional": "^10.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
